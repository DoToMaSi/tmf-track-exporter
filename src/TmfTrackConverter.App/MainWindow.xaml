<Window x:Class="TmfTrackConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TmfTrackConverter.App"
        Title="TMF Track Converter"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="14,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="SettingsButton" Content="Settings" Click="OnSettings" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TMF Track Converter" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button x:Name="OpenButton" Content="Open track…" Click="OnOpenTrack" />
                    <Button Style="{StaticResource AccentButton}" Content="Export FBX…" Click="OnExport" x:Name="ExportButton" IsEnabled="False" />
                    <CheckBox x:Name="IncludeEnvironmentExport" Content="Include environment" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#16171C" Foreground="{StaticResource MutedBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Select the game folder to get started." />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="14" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Track" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                        <TextBlock x:Name="InfoName" Text="No track loaded" FontSize="16" TextWrapping="Wrap" />
                        <TextBlock x:Name="InfoAuthor" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12" />
                        <TextBlock x:Name="InfoEnvironment" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock x:Name="InfoDecoration" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock x:Name="InfoSize" Margin="0,0,0,4" />
                        <TextBlock x:Name="InfoBlocks" Margin="0,0,0,4" />
                        <TextBlock x:Name="InfoEdition" Margin="0,0,0,4" />
                        <TextBlock x:Name="InfoPassword" Margin="0,0,0,12" />
                        <TextBlock x:Name="InfoCache" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <local:SchematicView x:Name="Schematic" />
                    <TextBlock x:Name="PreviewHint"
                               Text="Open a track to see a top-down schematic."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                </Grid>
            </Border>

            <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ListBox x:Name="LogList" Background="#1B1C22" Foreground="{StaticResource TextBrush}" BorderThickness="0" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
