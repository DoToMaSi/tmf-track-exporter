<Window x:Class="TmfTrackConverter.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="420" Width="640"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Background="{StaticResource BgBrush}" Padding="16">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Rebuild cache" Click="OnRebuild" />
            <Button Style="{StaticResource AccentButton}" Content="Save" Click="OnSave" />
            <Button Content="Close" Click="OnClose" />
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Game folder" FontWeight="SemiBold" />
            <DockPanel Margin="0,6,0,12">
                <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseGame" Margin="8,0,0,0" />
                <TextBox x:Name="GameFolderBox" IsReadOnly="True" />
            </DockPanel>

            <TextBlock Text="Default tracks folder" FontWeight="SemiBold" />
            <DockPanel Margin="0,6,0,12">
                <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseTracks" Margin="8,0,0,0" />
                <TextBox x:Name="TracksFolderBox" />
            </DockPanel>

            <TextBlock x:Name="CacheStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <CheckBox x:Name="IncludeEnvironment" Content="Include environment decoration mesh when available" />
            <CheckBox x:Name="SkipClips" Content="Skip clip / connector blocks" />
            <CheckBox x:Name="ExportObj" Content="Also write an OBJ sidecar next to the FBX" />
        </StackPanel>
    </DockPanel>
    </Border>
</Window>
